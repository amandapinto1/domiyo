# Domiyo: environment variables (sanitized example, no real values).
# Server-only values: never prefix any of these with NEXT_PUBLIC_.
# Copy to .env for local development and fill in; in production, set these
# in the hosting platform's secret manager. Never commit a real .env.
# Details: docs/ARCHITECTURE.md > "Configuration".

# Database (application role). Local: postgres://domiyo:<POSTGRES_PASSWORD>@127.0.0.1:5432/domiyo
DATABASE_URL=
# Separate database used only by end-to-end tests (pnpm test:e2e); same as above with /domiyo_test
TEST_DATABASE_URL=

# App (production: https://domiyo.app; local: http://localhost:3000)
APP_PUBLIC_URL=http://localhost:3000
APP_DEFAULT_TIME_ZONE=America/Fortaleza

# Authentication (Better Auth). Secret: 32+ random bytes, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BETTER_AUTH_URL is the app's public base URL (same as APP_PUBLIC_URL).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Field-level encryption (32 random bytes, base64). Keep a copy in your
# password manager: losing the key makes encrypted data unrecoverable.
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_VERSION=1
# Only while rotating keys:
FIELD_ENCRYPTION_KEY_PREVIOUS=

# Email: "console" for development, "smtp" once a provider is chosen
EMAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Domiyo
